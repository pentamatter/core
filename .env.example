# Server
PORT=8080

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=matter_core

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

# Admin (first user with this email becomes admin)
ADMIN_EMAIL=admin@example.com

# OAuth2 - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth2 - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URLs (required for cross-origin deployment)
# Frontend URL - your blog frontend domain
FRONTEND_URL=http://localhost:3000
# Backend URL - your API server domain (used for OAuth callback and secure cookie detection)
BACKEND_URL=http://localhost:8080
